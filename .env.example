NETRA_ENV=development
NETRA_API_ORIGIN=http://127.0.0.1:8000
POSTGRES_USER=netra
POSTGRES_PASSWORD=replace-for-production
POSTGRES_DB=netra
NEO4J_AUTH=neo4j/replace-for-production

# Authentication & RBAC Configuration (Optional in development mode: defaults to built-in dev credentials)
# In production, set a strong secret:
# NETRA_JWT_SECRET=production-random-secret-key
# Custom user JSON mapping {username: {password: str, role: ADMIN|RISK_ANALYST|INVESTIGATOR|VIEWER}}:
# NETRA_AUTH_USERS_JSON='{"admin":{"password":"...","role":"ADMIN"}}'

